# Supabase - 매장/직원 로그인 데이터에 필요
# Supabase 대시보드 → Project Settings → API 에서 복사
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT 서명용 시크릿 (권장: 32자 이상 랜덤 문자열)
# 미설정 시 SUPABASE_ANON_KEY 사용 (운영에서는 별도 설정 권장)
# JWT_SECRET=your-random-secret-at-least-32-chars

# Resend - 급여 명세서 이메일 발송에 필요 (resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# RESEND_FROM=payroll@yourdomain.com  # 선택. 미설정 시 onboarding@resend.dev 사용

# Firebase FCM 푸시 알림
# Firebase Console → 프로젝트 설정 → 일반 → 웹 앱에서 복사
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# VAPID 키: Firebase Console → 프로젝트 설정 → Cloud Messaging → 웹 푸시 인증서
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# 서버용 서비스 계정 JSON 문자열 (Firebase Console → 프로젝트 설정 → 서비스 계정 → 키 생성)
FIREBASE_SERVICE_ACCOUNT_JSON=

# e-Tax XML 디지털 서명 (태국 국세청)
# .p12/.pfx 인증서를 base64 인코딩한 값. Windows: certutil -encode cert.p12 cert.b64
ETDA_CERT_BASE64=
ETDA_CERT_PASSWORD=

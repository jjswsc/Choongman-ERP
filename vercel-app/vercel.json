{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "ignoreCommand": "sh scripts/vercel-ignored-build-step.sh",
  "crons": [
    {
      "path": "/api/members/line-import/cron",
      "schedule": "5 18 * * *"
    },
    {
      "path": "/api/applyDuePriceSchedules",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/member-portal/cron/expire-pending-payments",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/member-portal/cron/reconcile-pending-payments",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/work-log-reminders",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/members/cron/expire-points",
      "schedule": "30 19 * * *"
    }
  ],
  "headers": [
    {
      "source": "/pos/qr-brands/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/downloads/(.*\\.apk)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}

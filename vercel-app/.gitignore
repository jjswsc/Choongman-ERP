# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
# ESLint JSON 리포트(로컬/CI 산출, 수 MB)
eslint-report.json
eslint-out.txt

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*.local

# Serwist (빌드 산출)
public/sw.js
public/swe-worker*

# Android signing secrets
android/keystore.properties
*.jks
*.keystore

# Windows POS local outputs/secrets
windows-pos/node_modules/
windows-pos/dist/
windows-pos/*.blockmap
# Inno/Electron 설치 산출물 — public/downloads 또는 별도 배포, Git에는 포함하지 않음
windows-pos/*.exe
windows-erp/node_modules/
windows-erp/dist/
windows-erp/*.blockmap

# 판매용 Windows 아이콘용 PNG — 빌드 시 rasterize-omnifoodtech-brand-icon.cjs 가 생성
assets/brand/omnifoodtech-logo.png

# Windows 설치 파일(~78MB×N). Git에는 latest.json 등만 두고, exe는 publish 스크립트로 배포 전 public에 복사
public/downloads/**/*.exe
# Android APK(100MB+ GitHub 제한). publish-android-apk.ps1 로 배포 시에만 public에 복사
public/downloads/**/*.apk

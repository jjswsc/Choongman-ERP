{
  "name": "choongman-pos-windows",
  "version": "0.1.14",
  "private": true,
  "author": "Choongman",
  "description": "Windows installed hybrid POS shell (Electron)",
  "main": "main.js",
  "scripts": {
    "dev": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "icon:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/generate-windows-pos-icon.ps1",
    "pack": "electron-builder --dir",
    "prebuild:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-windows-pos.ps1 -ClearDistOnly",
    "build:win": "npm run icon:win && electron-builder --win nsis portable"
  },
  "build": {
    "afterPack": "scripts/after-pack-win-icon.cjs",
    "forceCodeSigning": false,
    "appId": "com.choongman.erp.pos.windows",
    "productName": "Choongman POS",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": [
      "**/node_modules/serialport/**/*",
      "**/node_modules/@serialport/**/*",
      "**/node_modules/node-gyp-build/**/*"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*.ps1"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "offline.html",
      "runtime-config.json",
      "linkpos-bridge-server.js",
      {
        "from": "../lib/deploy-public-origin.cjs",
        "to": "lib/deploy-public-origin.cjs"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false,
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^2.1.8",
    "rcedit": "^4.0.1"
  }
}

{
  "appId": "com.omnifoodtech.pos.windows",
  "extraMetadata": {
    "name": "omnifoodtech-pos-windows"
  },
  "forceCodeSigning": false,
  "files": [
    "main.js",
    "preload.js",
    "offline.html",
    "pos-shell-recovery.js",
    "escpos-raster.js",
    "runtime-config.json",
    "linkpos-bridge-server.js",
    {
      "from": "../lib/deploy-public-origin.cjs",
      "to": "lib/deploy-public-origin.cjs"
    }
  ],
  "extraResources": [
    {
      "from": "scripts",
      "to": "scripts",
      "filter": [
        "**/*.ps1"
      ]
    }
  ],
  "win": {
    "signAndEditExecutable": false
  }
}
